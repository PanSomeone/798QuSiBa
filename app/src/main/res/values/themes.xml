<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Launcher theme. Its only real job is the window between "icon tapped" and
      "Compose drew its first frame" — the splash shade and the system bars.

      Deliberately NOT a DayNight parent. The app is a single dark theme with no
      light variant (see ui/theme/KhsTheme.kt), but a DayNight parent resolves its
      *own* colours from the system setting: on a phone in light mode this theme
      inflated a white window and a white action bar, and the app label was drawn
      in black on top of the splash (visible in _proof/02_login.png). One theme
      means one theme, whatever the phone happens to be set to.

      The bars get an opaque colour rather than the usual transparent one for the
      same reason it is safe to do so here: the app never has a light surface, so
      white icons are always correct, and an opaque bar cannot be scrimmed by the
      system into something else.
    -->
    <style name="Theme.KillHuiShengHuo" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@color/window_background</item>
        <item name="android:navigationBarColor">@color/window_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>
</resources>
