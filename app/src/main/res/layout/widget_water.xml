<?xml version="1.0" encoding="utf-8"?>
<!--
    桌面小组件。

    这一层不能用 Compose:RemoteViews 只认系统认识的那几类视图,所以它是一个
    LinearLayout 加三行字和一个按钮,全部靠 setText / setBackgroundResource /
    setOnClickPendingIntent 更新。

    「一键启动」那颗按钮在换状态时换的是**背景 drawable**,不是一个颜色值:
    RemoteViews 没有给「填色」的接口,而两个 drawable 各自带着渐变和圆角,换起来
    正好是一件事。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="true">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="惠生活 去死吧"
            android:textColor="#E9EEF6"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_pun"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="798 748"
            android:textColor="#6F7D93"
            android:textSize="10sp"
            android:letterSpacing="0.18" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_device"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="还没有设备"
        android:textColor="#96A2B5"
        android:textSize="11sp"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widget_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="热水已关"
        android:textColor="#96A2B5"
        android:textSize="12sp"
        android:maxLines="1" />

    <Button
        android:id="@+id/widget_button"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_btn_off"
        android:text="一键启动热水"
        android:textColor="#1A0A02"
        android:textSize="15sp"
        android:textStyle="bold"
        android:stateListAnimator="@null"
        android:includeFontPadding="false" />
</LinearLayout>
